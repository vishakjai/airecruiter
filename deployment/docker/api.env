# Non-secret defaults that let the local stack boot without external services.
# An ignored apps/api/.env file, when present, is loaded after this file and
# overrides these values with real integration credentials.
OPENAI_API_KEY=local-disabled
JOBDIVA_CLIENT_ID=local-disabled
JOBDIVA_USERNAME=local-disabled
JOBDIVA_PASSWORD=local-disabled
ENCRYPTION_KEY=local-development-only-key
ENCRYPTION_SALT=local-development-only-salt
EXA_CONTACT_ENRICH_ENABLED=false
AMPLITUDE_TRACK_LOGS=false
